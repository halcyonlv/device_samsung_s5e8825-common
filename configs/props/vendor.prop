# Adoptable Storage
ro.crypto.volume.options=aes-256-xts:aes-256-cts:v2

# APK Verity
ro.apk_verity.mode=2

# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
af.fast_track_multiplier=1
audio.offload.min.duration.secs=30
audio.timecheck.timeout_duration_ms=10000

# Bluetooth
bluetooth.device.class_of_device=90,1,16
bluetooth.device_id.vendor_id=0x0075
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.asha.central.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true
bluetooth.profile.sap.server.enabled=true

# Codec2
debug.stagefright.c2inputsurface=-1

# Dalvik
dalvik.vm.dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.dex2oat-threads=8
dalvik.vm.image-dex2oat-cpu-set=0,1,2,3,4,5,6,7
dalvik.vm.image-dex2oat-threads=8
dalvik.vm.lockprof.threshold=500

# Display
debug.sf.disable_client_composition_cache=0
debug.sf.enable_hwc_vds=0
persist.sys.sf.color_saturation=1.0
persist.sys.sf.native_mode=0
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.use_color_management=true

# Filesystem
fs_mgr.overlayfs.prefer_cache_backing_storage=true

# Graphics
debug.renderengine.backend=skiavkthreaded
debug.sf.auto_latch_unsignaled=0
debug.sf.enable_transaction_tracing=false
debug.sf.latch_unsignaled=0
debug.sf.predict_hwc_composition_strategy=0
persist.mm.enable.prefetch=true
ro.hardware.egl=mali
ro.hardware.vulkan=mali
ro.opengles.version=196610
ro.surface_flinger.clear_slots_with_set_layer_buffer=true
ro.surface_flinger.enable_frame_rate_override=false
ro.vendor.ddk.set.afbc=1

# HWUI
debug.hwui.skia_atrace_enabled=false
debug.hwui.use_hint_manager=true
debug.hwui.target_cpu_time_percent=30
debug.sf.enable_adpf_cpu_hint=true

# IORapd
iorapd.perfetto.enable=false
iorapd.readahead.enable=false

# Fdsan
debug.fdsan=warn_once

# FRP
ro.frp.pst=

# FUSE
persist.sys.fuse.passthrough.enable=true

# Incremental FS
ro.incremental.enable=true

# LMK
ro.lmk.filecache_min_kb=153600
ro.lmk.kill_timeout_ms=50
ro.lmk.kill_heaviest_task=true
ro.lmk.log_stats=false
ro.lmk.stall_limit_critical=40

# Metadata Encryption
ro.crypto.dm_default_key.options_format.version=2
ro.crypto.metadata_init_delete_all_keys.enabled=true
ro.crypto.volume.metadata.method=dm-default-key

# Perf
vendor.perf.framepacing.enable=1

# Power HAL
vendor.powerhal.disp.idle_support=false

# Pre-Rendering
ro.vendor.perf.scroll_opt=true

# RIL
ro.carrier=unknown
ro.radio.noril=no
vendor.rild.libpath=/vendor/lib64/libsec-ril.so
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so

# Samsung specific
ro.product_ship=true
ro.vendor.cscsupported=1

# Sensors
persist.vendor.sensors.debug.hal=0

# Soc
ro.soc.manufacturer=Samsung
ro.soc.model=Exynos 1280

# SurfaceFlinger
debug.sf.enable_gl_backpressure=false
ro.surface_flinger.support_kernel_idle_timer=true

# Wi-Fi
wifi.direct.interface=p2p0

# Vibrator
ro.vendor.vibrator_hal.click_duration=50
ro.vendor.vibrator_hal.tick_duration=45
ro.vendor.vibrator_hal.texture_tick_duration=30

# Vsync
debug.cpurend.vsync=false

# ZRAM writeback
ro.zram.first_wb_delay_mins=1440
ro.zram.mark_idle_delay_mins=60
ro.zram.periodic_wb_delay_hours=24

# Zygote
zygote.critical_window.minute=10
